{
  "info": {
    "_postman_id": "c1c04e2f-4c5a-4b2e-9b1a-crmleadsystem01",
    "name": "CRM Lead Management System",
    "description": "API collection for the CRM Lead Management System (Laravel 12 + Sanctum).\n\nDefault `base_url` is http://localhost/CRM_Lead_Managment/api (Laragon).\nIf you run `php artisan serve` instead, change it to http://127.0.0.1:8000/api.\nRun the `Login (Admin)` or `Login (Sales)` request first - the returned token is stored in the `token` collection variable automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/CRM_Lead_Managment/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "lead_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Authenticates as admin and stores the returned token."
          },
          "response": []
        },
        {
          "name": "Login (Sales)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Authenticates as a sales user and stores the returned token."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": ["{{base_url}}"],
              "path": ["me"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard - Lead counts by status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard",
              "host": ["{{base_url}}"],
              "path": ["dashboard"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1 555-123-4567\",\n  \"source\": \"WEBSITE\",\n  \"assigned_to\": 2,\n  \"remarks\": \"Interested in term life insurance.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/leads",
              "host": ["{{base_url}}"],
              "path": ["leads"]
            }
          },
          "response": []
        },
        {
          "name": "List Leads (search/filter/paginate)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/leads?search=&status=NEW&source=WEBSITE&page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["leads"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "status", "value": "NEW" },
                { "key": "source", "value": "WEBSITE" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Show Lead",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": ["{{base_url}}"],
              "path": ["leads", "{{lead_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Lead Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONTACTED\",\n  \"remarks\": \"Spoke with the customer.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": ["{{base_url}}"],
              "path": ["leads", "{{lead_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Assign Lead (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigned_to\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": ["{{base_url}}"],
              "path": ["leads", "{{lead_id}}"]
            },
            "description": "Only an ADMIN can (re)assign leads."
          },
          "response": []
        },
        {
          "name": "Delete Lead",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": ["{{base_url}}"],
              "path": ["leads", "{{lead_id}}"]
            },
            "description": "ADMIN only. Converted leads cannot be deleted."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Follow-ups",
      "item": [
        {
          "name": "List Follow-ups",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}/followups",
              "host": ["{{base_url}}"],
              "path": ["leads", "{{lead_id}}", "followups"]
            }
          },
          "response": []
        },
        {
          "name": "Create Follow-up",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"followup_date\": \"2026-09-01\",\n  \"notes\": \"Call back about the quote.\",\n  \"status\": \"PENDING\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}/followups",
              "host": ["{{base_url}}"],
              "path": ["leads", "{{lead_id}}", "followups"]
            }
          },
          "response": []
        },
        {
          "name": "Update Follow-up",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"notes\": \"Call completed.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/followups/1",
              "host": ["{{base_url}}"],
              "path": ["followups", "1"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.method === 'POST' && pm.request.url.path.includes('login')) {",
          "    const json = pm.response.json();",
          "    if (json.token) {",
          "        pm.collectionVariables.set('token', json.token);",
          "    }",
          "}"
        ]
      }
    }
  ]
}
